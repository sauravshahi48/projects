# Defaults work without an API key. Copy this file to .env if changing settings.
DOCASSIST_DATA_DIR=.data
DOCASSIST_RETRIEVAL=lexical

# Optional semantic search: pip install -e ".[semantic]"
# DOCASSIST_RETRIEVAL=hybrid
# DOCASSIST_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional generated answers: pip install -e ".[llm]"
# This sends the question and retrieved passages to the configured model provider.
DOCASSIST_LLM=off
# DOCASSIST_LLM=openai
# OPENAI_API_KEY=your_api_key
# DOCASSIST_LLM_MODEL=your_available_model_id

# Retrieval similarity cutoff; this is not a calibrated confidence probability.
# Defaults: lexical=0.12, hybrid=0.40. Tune on your own evaluation set.
# DOCASSIST_MIN_SCORE=0.12
