table 'Station Hours'
	lineageTag: 307b81b1-8394-5f94-b502-dfcf1f1e5923

	measure 'Baseline Energy kWh' = SUM('Station Hours'[baseline_kw])
		formatString: 0.00

	measure 'Scenario Energy kWh' = SUM('Station Hours'[scenario_kw])
		formatString: 0.00

	measure 'Station Baseline Peak kW' = MAX('Station Hours'[baseline_kw])
		formatString: 0.00

	measure 'Station Scenario Peak kW' = MAX('Station Hours'[scenario_kw])
		formatString: 0.00

	column date
		dataType: string
		summarizeBy: none
		sourceColumn: date

	column hour_of_day
		dataType: string
		summarizeBy: none
		sourceColumn: hour_of_day

	column station
		dataType: string
		summarizeBy: none
		sourceColumn: station

	column baseline_kw
		dataType: double
		summarizeBy: none
		sourceColumn: baseline_kw

	column scenario_kw
		dataType: double
		summarizeBy: none
		sourceColumn: scenario_kw

	partition 'Station Hours' = m
		mode: import
		source =
				let
				    Encoded = Text.Combine({
					"",
					"",
					"",
					"",
					""
				    }),
				    Bytes = Binary.Decompress(Binary.FromText(Encoded, BinaryEncoding.Base64), Compression.Deflate),
				    Csv = Csv.Document(Bytes, [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Csv, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"date", type text}, {"hour_of_day", type text}, {"station", type text}, {"baseline_kw", type number}, {"scenario_kw", type number}}, "en-US")
				in
				    Typed
