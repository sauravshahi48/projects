table 'Network Hours'
	lineageTag: 549189d6-f489-5c96-bec2-be72ce80c6ba

	measure 'Baseline Peak kW' = MAX('Network Hours'[baseline_kw])
		formatString: 0.00

	measure 'Scenario Peak kW' = MAX('Network Hours'[scenario_kw])
		formatString: 0.00

	measure 'Planning Capacity kW' = MAX('Network Hours'[capacity_kw])
		formatString: 0.00

	measure 'Peak Reduction' = DIVIDE([Baseline Peak kW] - [Scenario Peak kW], [Baseline Peak kW])
		formatString: 0.00%

	measure 'Baseline Hours Over Capacity' = SUM('Network Hours'[baseline_over_capacity])
		formatString: #,0

	measure 'Scenario Hours Over Capacity' = SUM('Network Hours'[scenario_over_capacity])
		formatString: #,0

	column hour_local
		dataType: string
		summarizeBy: none
		sourceColumn: hour_local

	column date
		dataType: string
		summarizeBy: none
		sourceColumn: date

	column hour_of_day
		dataType: string
		summarizeBy: none
		sourceColumn: hour_of_day

	column baseline_kw
		dataType: double
		summarizeBy: none
		sourceColumn: baseline_kw

	column scenario_kw
		dataType: double
		summarizeBy: none
		sourceColumn: scenario_kw

	column capacity_kw
		dataType: double
		summarizeBy: none
		sourceColumn: capacity_kw

	column baseline_over_capacity
		dataType: int64
		summarizeBy: none
		sourceColumn: baseline_over_capacity

	column scenario_over_capacity
		dataType: int64
		summarizeBy: none
		sourceColumn: scenario_over_capacity

	partition 'Network Hours' = m
		mode: import
		source =
				let
				    Encoded = Text.Combine({
					"",
					""
				    }),
				    Bytes = Binary.Decompress(Binary.FromText(Encoded, BinaryEncoding.Base64), Compression.Deflate),
				    Csv = Csv.Document(Bytes, [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Csv, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"hour_local", type text}, {"date", type text}, {"hour_of_day", type text}, {"baseline_kw", type number}, {"scenario_kw", type number}, {"capacity_kw", type number}, {"baseline_over_capacity", Int64.Type}, {"scenario_over_capacity", Int64.Type}}, "en-US")
				in
				    Typed
