table 'Delivery SLA'
	lineageTag: a2dd6313-232a-5f9e-8ad6-f1106c27ea17

	measure 'Total Orders' = SUM('Delivery SLA'[orders])
		formatString: #,0

	measure 'Total Breaches' = SUM('Delivery SLA'[breaches])
		formatString: #,0

	measure '30-min Breach Rate' = DIVIDE([Total Breaches], [Total Orders])
		formatString: 0.0%

	measure 'Avg Dispatch Minutes' = DIVIDE(SUM('Delivery SLA'[dispatch_total]), [Total Orders])
		formatString: 0.00

	measure 'Avg Pickup Minutes' = DIVIDE(SUM('Delivery SLA'[pickup_total]), [Total Orders])
		formatString: 0.00

	measure 'Avg Travel Minutes' = DIVIDE(SUM('Delivery SLA'[travel_total]), [Total Orders])
		formatString: 0.00

	column service_date
		dataType: string
		summarizeBy: none
		sourceColumn: service_date

	column order_hour
		dataType: int64
		summarizeBy: none
		sourceColumn: order_hour

	column hub_name
		dataType: string
		summarizeBy: none
		sourceColumn: hub_name

	column shift_band
		dataType: string
		summarizeBy: none
		sourceColumn: shift_band

	column rain_band
		dataType: string
		summarizeBy: none
		sourceColumn: rain_band

	column orders
		dataType: int64
		summarizeBy: none
		sourceColumn: orders

	column breaches
		dataType: int64
		summarizeBy: none
		sourceColumn: breaches

	column dispatch_total
		dataType: double
		summarizeBy: none
		sourceColumn: dispatch_total

	column pickup_total
		dataType: double
		summarizeBy: none
		sourceColumn: pickup_total

	column travel_total
		dataType: double
		summarizeBy: none
		sourceColumn: travel_total

	partition 'Delivery SLA' = m
		mode: import
		source =
				let
				    Encoded = Text.Combine({
					"",
					"",
					"",
					"",
					"",
					"",
					"",
					"",
					"",
					"",
					"",
					"",
					"",
					"",
					""
				    }),
				    Bytes = Binary.Decompress(Binary.FromText(Encoded, BinaryEncoding.Base64), Compression.Deflate),
				    Csv = Csv.Document(Bytes, [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Csv, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"service_date", type text}, {"order_hour", Int64.Type}, {"hub_name", type text}, {"shift_band", type text}, {"rain_band", type text}, {"orders", Int64.Type}, {"breaches", Int64.Type}, {"dispatch_total", type number}, {"pickup_total", type number}, {"travel_total", type number}}, "en-US")
				in
				    Typed
