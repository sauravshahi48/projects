table 'Rider Workload'
	lineageTag: 91c8506f-c5ae-5dde-9a5a-d4492fb503a7

	measure 'Hub-Hour Slots' = COUNTROWS('Rider Workload')
		formatString: #,0

	measure 'Staffing Review Slots' = SUM('Rider Workload'[staffing_review])
		formatString: #,0

	measure 'Orders per Scheduled Rider-Hour' = DIVIDE(SUM('Rider Workload'[orders]), SUM('Rider Workload'[scheduled_riders]))
		formatString: 0.00

	column hub_name
		dataType: string
		summarizeBy: none
		sourceColumn: hub_name

	column service_date
		dataType: string
		summarizeBy: none
		sourceColumn: service_date

	column order_hour
		dataType: int64
		summarizeBy: none
		sourceColumn: order_hour

	column scheduled_riders
		dataType: int64
		summarizeBy: none
		sourceColumn: scheduled_riders

	column orders
		dataType: int64
		summarizeBy: none
		sourceColumn: orders

	column breaches
		dataType: int64
		summarizeBy: none
		sourceColumn: breaches

	column orders_per_rider
		dataType: double
		summarizeBy: none
		sourceColumn: orders_per_rider

	column staffing_review
		dataType: int64
		summarizeBy: none
		sourceColumn: staffing_review

	partition 'Rider Workload' = m
		mode: import
		source =
				let
				    Encoded = Text.Combine({
					"",
					"",
					"",
					"",
					"",
					""
				    }),
				    Bytes = Binary.Decompress(Binary.FromText(Encoded, BinaryEncoding.Base64), Compression.Deflate),
				    Csv = Csv.Document(Bytes, [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Csv, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"hub_name", type text}, {"service_date", type text}, {"order_hour", Int64.Type}, {"scheduled_riders", Int64.Type}, {"orders", Int64.Type}, {"breaches", Int64.Type}, {"orders_per_rider", type number}, {"staffing_review", Int64.Type}}, "en-US")
				in
				    Typed
